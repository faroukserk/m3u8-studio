# Rust build outputs. Keep only the shipped release binary and its extension.
/target/*
!/target/release/
/target/release/*
!/target/release/m3u8-studio.exe
!/target/release/extension/
/target/release/extension/.installed-version

# Editors and OS clutter
/.vscode/
/.idea/
*.swp
.DS_Store
Thumbs.db

# Local data and logs
*.log
settings.txt

# Installer output
/dist/
/m3u8-studio-*-setup.exe
