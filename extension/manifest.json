{
  "manifest_version": 3,
  "name": "m3u8 studio bridge",
  "version": "1.3.0",
  "description": "Find HLS streams on any page and send them to the m3u8 studio desktop app.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:37811/", "http://localhost:37811/"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "m3u8 studio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["api.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ]
}
