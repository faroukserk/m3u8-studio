// Design tokens and icon geometry shared by every screen.

export global Tokens {
    // Surfaces
    out property <color> bg: #0A0C11;
    out property <color> panel: #11141C;
    out property <color> panel-2: #151925;
    out property <color> panel-3: #1A1F2D;
    out property <color> input: #141824;
    out property <color> log-bg: #090B10;

    // Lines
    out property <color> border: #212634;
    out property <color> border-strong: #2C3344;

    // Text
    out property <color> text: #E9ECF4;
    out property <color> dim: #9AA3B7;
    out property <color> faint: #646E85;

    // Accent
    out property <color> accent: #7C8CFF;
    out property <color> accent-2: #B083FF;
    out property <color> accent-soft: #7C8CFF1F;
    out property <color> accent-line: #7C8CFF66;
    out property <color> accent-text: #C4CCFF;

    // Status
    out property <color> green: #3DDC97;
    out property <color> green-soft: #3DDC971A;
    out property <color> amber: #F5B860;
    out property <color> amber-soft: #F5B8601A;
    out property <color> red: #FF6B81;
    out property <color> red-soft: #FF6B811A;
    out property <color> slate: #8A94AB;
    out property <color> slate-soft: #8A94AB17;

    out property <brush> accent-gradient: @linear-gradient(115deg, #7C8CFF 0%, #B083FF 100%);
    out property <brush> progress-gradient: @linear-gradient(90deg, #7C8CFF 0%, #B083FF 100%);

    out property <string> font: "Segoe UI";
    out property <string> mono: "Consolas";
}

